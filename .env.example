# RentMitra Environment Variables
# Copy this to .env and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/rentmitra
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=rentmitra

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# ── Email (Zoho SMTP) ────────────────────────────────────────────────────────
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_EMAIL=noreply@yourdomain.com
ZOHO_PASSWORD=your_zoho_app_password

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://your-rentmitra-domain.com
UPLOAD_DIR=/var/uploads/rentmitra

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# The frontend uses Google's OAuth JS library — no server-side secret needed
# Just configure your Google OAuth Client ID in the frontend environment:
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
